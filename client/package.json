{
  "name": "audio-client",
  "version": "0.1.0",
  "description": "Cadence local transcription Electron client",
  "author": "Local",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "electron-vite build && electron-builder --mac dir",
    "preview": "electron-vite preview",
    "dev:test-client": "tsx src/testClient.ts",
    "test:audio-filter": "node --import tsx src/renderer/audio/runAudioSpecs.ts"
  },
  "build": {
    "appId": "local.audio.transcriber",
    "productName": "Cadence",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cadence needs microphone access to transcribe local audio.",
        "NSScreenCaptureDescription": "Cadence may use screen or system audio capture for local meeting transcription."
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "ws": "^8.21.0"
  }
}
